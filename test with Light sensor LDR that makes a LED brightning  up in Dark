int led = 3; 
int sensor = A0; 
int valorsensor = 0;
void setup() { 
Serial.begin(9600); 
pinMode (led, OUTPUT); 
pinMode (sensor, INPUT); 

}
void loop() { 
 Serial.println(valorsensor); 

valorsensor = analogRead (sensor);


 if((valorsensor) < 300){ 
 digitalWrite(led, HIGH);
}else{
 digitalWrite(led, LOW);
 }
}
